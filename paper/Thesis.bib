	file = {Allen_Arkolakis_2014_Trade and the Topography of the Spatial Economy.pdf:C\:\\Users\\JianingShao\\Zotero\\storage\\I3RSXY4F\\Allen_Arkolakis_2014_Trade and the Topography of the Spatial Economy.pdf:application/pdf;QJEC12903_ALLEN_ONLINE_APPENDIX.pdf:C\:\\Users\\JianingShao\\Zotero\\storage\\BH4MU4YM\\QJEC12903_ALLEN_ONLINE_APPENDIX.pdf:application/pdf;Snapshot:C\:\\Users\\JianingShao\\Zotero\\storage\\HBNGJ3WL\\1818077.html:text/html},
}

